# Dockerfile for Streaming Pipelines

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-11-jre-headless \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set Java environment
ENV JAVA_HOME=/usr/lib/jvm/java-11-openjdk-amd64
ENV PATH=$JAVA_HOME/bin:$PATH

# Install Python dependencies
WORKDIR /app
COPY pyproject.toml .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e ".[dev,streaming]"

# Copy application code
COPY libs/ ./libs/
COPY pipelines/streaming/ ./pipelines/streaming/
COPY configs/ ./configs/

# Set Python path
ENV PYTHONPATH=/app

# Default command
CMD ["python", "-m", "pipelines.streaming.event_processor.main", "--config", "configs/dev/pipeline.yaml"]